# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/staymate_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Cloudinary Image Upload (Optional - Local storage fallback is used if missing)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Maps API (Optional - Interactive map placeholder fallback if missing)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Default Administrator Credentials (used during npm run seed)
ADMIN_EMAIL=admin@staymate.com
ADMIN_PASSWORD=Admin@123

# Socket.IO Server URL
SOCKET_URL=http://localhost:5000
