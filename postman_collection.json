    {
      "name": "Properties",
      "item": [
        {
          "name": "Search Approved Properties",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/properties?city=Bangalore&propertyType=PG&minRent=5000&maxRent=15000",
              "host": ["{{baseUrl}}"],
              "path": ["properties"],
              "query": [
                { "key": "city", "value": "Bangalore" },
                { "key": "propertyType", "value": "PG" },
                { "key": "minRent", "value": "5000" },
                { "key": "maxRent", "value": "15000" }
              ]
            }
          }
        },
        {
          "name": "Get Property Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/properties/{{propertyId}}", "host": ["{{baseUrl}}"], "path": ["properties", "{{propertyId}}"] }
          }
        },
        {
          "name": "Create Property Listing (Owner)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Maple Leaf Student PG Koramangala\",\n  \"description\": \"Spacious double sharing rooms with attached bath, high speed wifi, and food.\",\n  \"propertyType\": \"PG\",\n  \"monthlyRent\": 9500,\n  \"securityDeposit\": 19000,\n  \"address\": \"14th Main, 4th Block\",\n  \"locality\": \"Koramangala\",\n  \"city\": \"Bangalore\",\n  \"occupancyType\": \"Double\",\n  \"genderPreference\": \"Male\",\n  \"amenities\": [\"WiFi\", \"RO Water\", \"Power Backup\"],\n  \"foodAvailability\": true,\n  \"foodType\": \"Both\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/properties", "host": ["{{baseUrl}}"], "path": ["properties"] }
          }
        }
      ]
    },
    {
      "name": "Roommates",
      "item": [
        {
          "name": "Discover Compatible Roommates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": { "raw": "{{baseUrl}}/roommates?city=Bangalore", "host": ["{{baseUrl}}"], "path": ["roommates"] }
          }
        },
        {
          "name": "Send Connection Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hey, our preferences match! Would love to find a 2BHK flat together.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/roommates/{{candidateId}}/connect", "host": ["{{baseUrl}}"], "path": ["roommates", "{{candidateId}}", "connect"] }
          }
        }
      ]
    },
    {
      "name": "Mess Services",
      "item": [
        {
          "name": "Search Mess Listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/mess?city=Bangalore&foodType=Veg", "host": ["{{baseUrl}}"], "path": ["mess"] }
