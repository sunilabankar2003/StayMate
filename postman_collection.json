        {
          "name": "Verify Property (Approve / Reject)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/properties/{{propertyId}}/verify", "host": ["{{baseUrl}}"], "path": ["admin", "properties", "{{propertyId}}", "verify"] }
          }
        }
      ]
    }
